# Cloud Deployment Environment Variables

# API Keys (Provide your own for cloud usage)
HF_TOKEN=your_huggingface_token_here
VIDEO_API_KEY=your_api_key_here

# Video Engine Configuration
VIDEO_PROVIDER=wan_local
VIDEO_ENGINE=wan

# Wan 2.2 Model Settings
# /app/models is the volume mounted in docker-compose
WAN_MODEL_PATH=/app/models/Wan2.2-TI2V-5B-Diffusers
WAN_DEVICE=cuda:0
WAN_ENABLE_CPU_OFFLOAD=true

# Database (Local SQLite for now, can be updated to PostgreSQL)
DATABASE_URL=sqlite:///./universe_platform.db
